   "source": [
    "import numpy as np"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "288b3d48-fb1e-4289-91ca-ec853942160e",
   "metadata": {},
   "outputs": [],
   "source": [
    "A = np.array([[1,1],[0,1]])  # shear\n",
    "B = np.array([[0,-1],[1,0]]) # rotation 90°"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "6ec5b2b6-08cc-446f-b637-2a75a4795f61",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "[[ 1 -1]\n",
      " [ 1  0]]\n",
      "[[ 0 -1]\n",
      " [ 1  1]]\n"
     ]
    }
   ],
   "source": [
    "print(A @ B)  # shear then rotate\n",
    "print(B @ A)  # rotate then shear"
   ]
  },
